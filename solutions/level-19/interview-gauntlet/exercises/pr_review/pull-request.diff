--- a/payments/api.py
+++ b/payments/api.py
@@ -12,6 +12,7 @@ from payments.ledger import Ledger
 from payments.vault import Vault

+FEE_RATE = 0.029
+
 @app.post("/payments")
-def take_payment(body: PaymentIn):
+def take_payment(body: PaymentIn, background: BackgroundTasks):
     card = body.card_number
-    payment = ledger.record(body.amount_minor, body.merchant_id)
+    fee = body.amount_minor * FEE_RATE
