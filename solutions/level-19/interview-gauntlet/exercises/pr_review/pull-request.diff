--- a/payments/reporting.py
+++ b/payments/reporting.py
@@ -30,3 +30,12 @@ def merchant_summary(merchant_id: str):
     rows = db.query("select * from payments where merchant_id = %s", merchant_id)
+    total = 0
+    for row in rows:
+        # one query per payment to get the refunds
+        refunds = db.query("select * from refunds where payment_id = %s", row["id"])
+        total += row["amount_minor"] - sum(r["amount_minor"] for r in refunds)
+    metrics.gauge("merchant_total", total, tags={"merchant_id": merchant_id})
+    return total

